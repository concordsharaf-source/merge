{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "حسابي",
  "version": "1.0.0",
  "identifier": "com.hesabi.store",
  "build": {
    "beforeDevCommand": "pnpm dev:desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [{
      "title": "حسابي | إدارة متجرك",
      "width": 1440,
      "height": 900,
      "minWidth": 1024,
      "minHeight": 680,
      "resizable": true,
      "fullscreen": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "targets": ["msi", "nsis", "appimage", "deb"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  },
  "plugins": { "shell": { "open": true } }
}
